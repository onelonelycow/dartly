# Python
__pycache__/
*.pyc
.venv/
venv/

# App data + secrets
demand_radar.db
alert_prefs.json
.env
*.log
drafts.json

# per-user state (profiles, alert channels, drafts) — never committed
users/
profile.json
drafts.json
alert_prefs.json

# Runtime databases: these fill up with signup emails and feedback the moment
# real people use the site, and this repo is public. seed.db stays tracked on
# purpose (bundled gigs, no personal data, needed for first boot).
nabbly_people.db
nabbly_signals.db
# AI spend ledger: per-account draft counts keyed by storage scope, plus the
# cached draft text itself. Both are user data on a public repo.
budget.db
# Apply-click log: per-account activity, same reasoning as budget.db above.
activity.db
# Who landed which gig — per-account outcome history, same reasoning again.
nabbly_outcomes.db
# Per-account 👍/👎 on match scores, same reasoning again.
nabbly_match_feedback.db
*.db-wal
*.db-shm

# Written at boot by auth.py from environment variables. Contains the Google
# OAuth client secret and the cookie signing key.
.streamlit/secrets.toml
