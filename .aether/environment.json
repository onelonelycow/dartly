{
  "setup": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",
  "terminals": [
    {
      "name": "Streamlit App",
      "command": ".venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0",
      "port": 8501
    },
    {
      "name": "Board Service",
      "command": ".venv/bin/uvicorn web.main:app --host 0.0.0.0 --port 8000 --reload",
      "port": 8000
    }
  ]
}
